{
  "name": "qagent-pet-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "QAgent Pet Electron desktop pet MVP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:icons": "node scripts/build-icons.js",
    "build:backend": "node scripts/build-backend.js",
    "dist": "npm run build:icons && npm run build:backend && electron-builder",
    "dist:dir": "npm run build:icons && npm run build:backend && electron-builder --dir"
  },
  "author": "QAgent Pet",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qagent.pet",
    "productName": "QAgent Pet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload_web.js",
      "preload_setup.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend"
      },
      {
        "from": "backend-dist/qagent-backend",
        "to": "backend"
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
