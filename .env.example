# QAgent Pet 环境配置模板
# 复制此文件为 .env 并填写相应的值

# ============ LLM 配置 ============
# MiniMax API Key（必填）
# 获取地址: https://platform.minimaxi.chat/
LLM_API_KEY=your_minimax_api_key_here

# LLM API 基础地址
LLM_BASE_URL=https://api.minimax.chat/v1

# 主模型（使用 MiniMax-M2.5）
LLM_MODEL=MiniMax-M2.5

# ============ 天气 API 配置 ============
# 天气 API Key（可选，用于天气查询功能）
WEATHER_API_KEY=

# ============ 数据库配置 ============
# SQLite 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./qagent_pet.db

# ============ 服务配置 ============
# 后端服务端口
PORT=10000
