# QAgent Pet 环境配置模板
# 复制此文件为 .env 并填写相应的值

# ============ LLM 配置 ============
# MiniMax API Key（必填）
# 获取地址: https://api.minimax.chat/
LLM_API_KEY=your_minimax_api_key_here

# LLM API 基础地址（可选，默认使用 MiniMax）
# 格式: https://api.minimax.chat/v1
LLM_BASE_URL=https://api.minimax.chat/v1

# 主模型（可选，默认 MiniMax-Text-01）
LLM_MODEL=MiniMax-Text-01

# 备用模型（可选，当主模型失败时使用）
LLM_MODEL_BACKUP=MiniMax-Text-01-Turbo

# ============ 天气 API 配置 ============
# 天气 API Key（可选，用于天气查询功能）
# 如果使用 OpenWeatherMap: https://openweathermap.org/api
WEATHER_API_KEY=

# ============ 数据库配置 ============
# SQLite 数据库路径（可选，默认 ./qagent_pet.db）
# 格式: sqlite+aiosqlite:///./path/to/database.db
DATABASE_URL=sqlite+aiosqlite:///./qagent_pet.db

# ============ 服务配置 ============
# 后端服务端口（可选，默认 10000）
PORT=10000
