# QAgent Pet 环境配置模板
# 复制此文件为 .env 并填写相应的值

# ============ LLM 配置 ============
# MiniMax API Key（必填）
# 获取地址: https://platform.minimaxi.chat/
LLM_API_KEY=your_minimax_api_key_here

# LLM API 基础地址
LLM_BASE_URL=https://api.minimaxi.com/anthropic

# 主模型（使用 MiniMax-M2.5）
LLM_MODEL=MiniMax-M2.5

# ============ 天气 API 配置 ============
# 天气 API Key（可选，用于天气查询功能）
WEATHER_API_KEY=

# ============ 数据库配置 ============
# SQLite 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./qagent_pet.db

# ============ 服务配置 ============
# 后端服务端口
PORT=10000

# ============ API 认证 ============
# API Key（生产环境必须设置为强密码）
# 为空时跳过认证（开发模式）
API_KEY=

# ============ CORS 配置 ============
# 允许的源域名，逗号分隔
# 本地开发可保留下方默认值；生产环境应限制为实际域名，如 "https://your-frontend.example.com"
CORS_ORIGINS=http://localhost:10000,http://127.0.0.1:10000

# ============ 日志配置 ============
# 生产环境建议 WARNING
LOG_LEVEL=INFO

# ============ 记忆（预算为 token；缺少对应模型 tokenizer 时保守估算） ============
MEMORY_CONTEXT_TOKENS=16000
MEMORY_OUTPUT_TOKENS=2000
MEMORY_SAFETY_TOKENS=1000
MEMORY_SHORT_TOKENS=6000
MEMORY_RECALL_TOKENS=2000
MEMORY_BATCH_TOKENS=4000
MEMORY_CANDIDATES=40
MEMORY_MIN_SIMILARITY=0.35
MEMORY_WORKER_INTERVAL=5
MEMORY_EXTRACTION_ENABLED=true
MEMORY_SHADOW_MODE=false

# 独立配置 OpenAI 格式的 Embedding 接口；为空时使用事实/中文关键词检索。
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ============ 部署安全建议 ============
# 1. 生产环境设置强密码 API_KEY
# 2. 使用 nginx/Caddy 反向代理终止 TLS
# 3. chmod 600 qagent_pet.db
# 4. 设置 LOG_LEVEL=WARNING
